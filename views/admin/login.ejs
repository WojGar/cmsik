<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <title><%= title %> – CMSik</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="shortcut icon" href="/traveland/assets/images/favicon.png" type="image/png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0/dist/css/tabler.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.0/dist/tabler-icons.min.css">
  <link rel="stylesheet" href="/admin/admin.css">
  <style>
    body { background: linear-gradient(135deg,#1f2933 0%,#2c3e50 60%,#38424d 100%); min-height:100vh; }
    .login-card { max-width: 420px; margin: 0 auto; border: 0; box-shadow: 0 30px 60px rgba(0,0,0,.25); border-radius: 12px; }
    .login-brand img { height: 44px; }
  </style>
</head>
<body class="d-flex align-items-center py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card card-body login-card">
          <div class="text-center mb-4 login-brand">
            <img src="/<%= settings.logo_url || 'traveland/assets/images/logo.svg' %>" alt="<%= settings.site_name || 'TraveLand' %>">
            <h1 class="h3 mt-3 mb-0">CMSik – panel administratora</h1>
            <p class="text-muted small">Zaloguj się, aby zarządzać treścią serwisu.</p>
          </div>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><i class="ti ti-alert-circle me-2"></i> <%= error %></div>
          <% } %>
          <% if (flash.success && flash.success.length) { %>
            <% flash.success.forEach(function(m){ %>
              <div class="alert alert-success"><i class="ti ti-check me-2"></i> <%= m %></div>
            <% }); %>
          <% } %>
          <% if (flash.info && flash.info.length) { %>
            <% flash.info.forEach(function(m){ %>
              <div class="alert alert-info"><i class="ti ti-info-circle me-2"></i> <%= m %></div>
            <% }); %>
          <% } %>

          <form action="/admin/login" method="post" autocomplete="off">
            <div class="mb-3">
              <label class="form-label">E-mail</label>
              <div class="input-icon">
                <span class="input-icon-addon"><i class="ti ti-mail"></i></span>
                <input type="email" name="email" class="form-control" placeholder="admin@cmsik.local" value="<%= email %>" required autofocus>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Hasło</label>
              <div class="input-icon">
                <span class="input-icon-addon"><i class="ti ti-lock"></i></span>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required>
              </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <label class="form-check">
                <input type="checkbox" class="form-check-input">
                <span class="form-check-label">Zapamiętaj mnie</span>
              </label>
              <a href="/admin/forgot" class="small">Zapomniałeś hasła?</a>
            </div>
            <button type="submit" class="btn btn-primary w-100">
              <i class="ti ti-login me-1"></i> Zaloguj się
            </button>
          </form>

          <hr class="my-4">
          <div class="text-center">
            <a href="/" class="text-muted small">← Wróć do strony</a>
          </div>
        </div>
        <p class="text-center text-white-50 small mt-3">
          © <%= new Date().getFullYear() %> <%= settings.site_name || 'TraveLand' %> · CMSik
        </p>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0/dist/js/tabler.min.js"></script>
</body>
</html>
