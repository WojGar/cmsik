<%- include('partials/_top') %>

<div class="page-header d-print-none mb-3">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title"><i class="ti ti-layout-grid me-2"></i> Treść sekcji strony głównej</h2>
      <p class="text-muted">Edytuj nagłówki, teksty, przyciski, zdjęcia, ikony i liczniki. Puste pola są ignorowane.</p>
    </div>
  </div>
</div>

<form action="/admin/sections" method="post">
  <%-
    (function () {
      // Group components by block_type for nicer UI
      const groups = {
        hero:            { title: 'Sekcja Home (hero)',     icon: 'ti-home',      keys: ['home_title','home_subtitle','home_button_text','home_button_link','home_image'] },
        about:           { title: 'Sekcja About Us',         icon: 'ti-info-circle', keys: ['about_eyebrow','about_title','about_text_1','about_text_2','about_button_text','about_button_link','about_image'] },
        counter:         { title: 'Liczniki (About Us)',     icon: 'ti-chart-bar',  keys: ['counter_1','counter_2','counter_3','counter_4'] },
        service_heading: { title: 'Nagłówek sekcji Services',icon: 'ti-tag',       keys: ['services_eyebrow','services_title'] },
        service_tile:    { title: 'Kafelki Services',        icon: 'ti-grid-dots',  keys: null /* all service_tile */ },
        blog_heading:    { title: 'Nagłówek sekcji Blog',    icon: 'ti-book',      keys: ['blog_eyebrow','blog_title'] },
        contact_heading: { title: 'Nagłówek sekcji Contact', icon: 'ti-mail',      keys: ['contact_eyebrow','contact_title','contact_text'] },
        footer:          { title: 'Stopka',                  icon: 'ti-layout-bottom', keys: ['footer_about'] }
      };
      return '';
    })()
  %>

  <%
    const find = (key) => comps.find(c => c.key === key) || { id: null, key, label:'', text:'', icon:'', image_url:'', link:'' };
    const tiles = comps.filter(c => c.block_type === 'service_tile');
  %>

  <!-- ========== HERO ========== -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-home me-2"></i> Sekcja Home (hero)</h3></div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <label class="form-label">Etykieta przed wyróżnionym słowem</label>
          <input type="text" class="form-control" name="components[<%= find('home_title').id %>][label]" value="<%= find('home_title').label %>">
          <small class="form-hint text-muted">Np. „Explore the world with”.</small>
        </div>
        <div class="col-md-6">
          <label class="form-label">Wyróżnione słowo</label>
          <input type="text" class="form-control" name="components[<%= find('home_title').id %>][text]" value="<%= find('home_title').text %>">
          <small class="form-hint text-muted">Np. „TraveLand”.</small>
        </div>
        <div class="col-md-8 mt-2">
          <label class="form-label">Tekst podtytułu</label>
          <textarea class="form-control" rows="2" name="components[<%= find('home_subtitle').id %>][text]"><%= find('home_subtitle').text %></textarea>
        </div>
        <div class="col-md-4 mt-2">
          <label class="form-label">Zdjęcie tła (ścieżka)</label>
          <input type="text" class="form-control" name="components[<%= find('home_image').id %>][image_url]" value="<%= find('home_image').image_url %>">
          <small class="form-hint text-muted">Np. <code>traveland/assets/images/hero-area.jpg</code> lub <code>uploads/img-…</code>.</small>
        </div>
        <div class="col-md-6 mt-2">
          <label class="form-label">Tekst przycisku</label>
          <input type="text" class="form-control" name="components[<%= find('home_button_text').id %>][text]" value="<%= find('home_button_text').text %>">
        </div>
        <div class="col-md-6 mt-2">
          <label class="form-label">Link przycisku (kotwica)</label>
          <input type="text" class="form-control" name="components[<%= find('home_button_link').id %>][text]" value="<%= find('home_button_link').text %>">
          <small class="form-hint text-muted">Np. <code>#services</code>.</small>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== ABOUT ========== -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-info-circle me-2"></i> Sekcja About Us</h3></div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4">
          <label class="form-label">Etykieta (eyebrow)</label>
          <input type="text" class="form-control" name="components[<%= find('about_eyebrow').id %>][label]" value="<%= find('about_eyebrow').label %>">
        </div>
        <div class="col-md-8">
          <label class="form-label">Nagłówek (HTML dozwolony, <code>&lt;span&gt;</code> = wyróżnienie)</label>
          <input type="text" class="form-control" name="components[<%= find('about_title').id %>][text]" value="<%= find('about_title').text %>">
        </div>
        <div class="col-md-6 mt-2">
          <label class="form-label">Tekst akapitu 1</label>
          <textarea class="form-control" rows="3" name="components[<%= find('about_text_1').id %>][text]"><%= find('about_text_1').text %></textarea>
        </div>
        <div class="col-md-6 mt-2">
          <label class="form-label">Tekst akapitu 2</label>
          <textarea class="form-control" rows="3" name="components[<%= find('about_text_2').id %>][text]"><%= find('about_text_2').text %></textarea>
        </div>
        <div class="col-md-4 mt-2">
          <label class="form-label">Zdjęcie (ścieżka)</label>
          <input type="text" class="form-control" name="components[<%= find('about_image').id %>][image_url]" value="<%= find('about_image').image_url %>">
        </div>
        <div class="col-md-4 mt-2">
          <label class="form-label">Tekst przycisku</label>
          <input type="text" class="form-control" name="components[<%= find('about_button_text').id %>][text]" value="<%= find('about_button_text').text %>">
        </div>
        <div class="col-md-4 mt-2">
          <label class="form-label">Link przycisku</label>
          <input type="text" class="form-control" name="components[<%= find('about_button_link').id %>][text]" value="<%= find('about_button_link').text %>">
        </div>
      </div>
    </div>
  </div>

  <!-- ========== COUNTERS ========== -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-chart-bar me-2"></i> Liczniki (4)</h3></div>
    <div class="card-body">
      <div class="row">
        <% ['counter_1','counter_2','counter_3','counter_4'].forEach(function(k) { const c = find(k); %>
          <div class="col-md-3">
            <label class="form-label">Wartość #<%= k.slice(-1) %></label>
            <input type="text" class="form-control" name="components[<%= c.id %>][label]" value="<%= c.label %>">
            <label class="form-label mt-2">Etykieta</label>
            <input type="text" class="form-control" name="components[<%= c.id %>][text]" value="<%= c.text %>">
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- ========== SERVICES HEADING ========== -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-tag me-2"></i> Nagłówek sekcji Services</h3></div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4">
          <label class="form-label">Etykieta (eyebrow)</label>
          <input type="text" class="form-control" name="components[<%= find('services_eyebrow').id %>][label]" value="<%= find('services_eyebrow').label %>">
        </div>
        <div class="col-md-8">
          <label class="form-label">Nagłówek (HTML dozwolony)</label>
          <input type="text" class="form-control" name="components[<%= find('services_title').id %>][text]" value="<%= find('services_title').text %>">
        </div>
      </div>
    </div>
  </div>

  <!-- ========== SERVICE TILES ========== -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-grid-dots me-2"></i> Kafelki Services</h3></div>
    <div class="card-body">
      <% tiles.forEach(function(t) { %>
        <div class="row mb-2 pb-2 border-bottom">
          <div class="col-md-3">
            <label class="form-label">Ikona (klasa LineIcons)</label>
            <input type="text" class="form-control" name="components[<%= t.id %>][icon]" value="<%= t.icon %>">
            <small class="form-hint text-muted">Np. <code>lni lni-guide</code>.</small>
          </div>
          <div class="col-md-3">
            <label class="form-label">Tytuł</label>
            <input type="text" class="form-control" name="components[<%= t.id %>][label]" value="<%= t.label %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Opis</label>
            <textarea class="form-control" rows="2" name="components[<%= t.id %>][text]"><%= t.text %></textarea>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <!-- ========== BLOG HEADING ========== -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-book me-2"></i> Nagłówek sekcji Blog</h3></div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4">
          <label class="form-label">Etykieta (eyebrow)</label>
          <input type="text" class="form-control" name="components[<%= find('blog_eyebrow').id %>][label]" value="<%= find('blog_eyebrow').label %>">
        </div>
        <div class="col-md-8">
          <label class="form-label">Nagłówek (HTML dozwolony)</label>
          <input type="text" class="form-control" name="components[<%= find('blog_title').id %>][text]" value="<%= find('blog_title').text %>">
        </div>
      </div>
    </div>
  </div>

  <!-- ========== CONTACT HEADING ========== -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-mail me-2"></i> Nagłówek sekcji Contact</h3></div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4">
          <label class="form-label">Etykieta (eyebrow)</label>
          <input type="text" class="form-control" name="components[<%= find('contact_eyebrow').id %>][label]" value="<%= find('contact_eyebrow').label %>">
        </div>
        <div class="col-md-8">
          <label class="form-label">Nagłówek (HTML dozwolony)</label>
          <input type="text" class="form-control" name="components[<%= find('contact_title').id %>][text]" value="<%= find('contact_title').text %>">
        </div>
        <div class="col-12 mt-2">
          <label class="form-label">Tekst pomocniczy</label>
          <textarea class="form-control" rows="2" name="components[<%= find('contact_text').id %>][text]"><%= find('contact_text').text %></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== FOOTER ========== -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-layout-bottom me-2"></i> Stopka</h3></div>
    <div class="card-body">
      <label class="form-label">Tekst „o nas” w stopce</label>
      <textarea class="form-control" rows="2" name="components[<%= find('footer_about').id %>][text]"><%= find('footer_about').text %></textarea>
      <small class="form-hint text-muted">Pozostałe ustawienia stopki (linki social, copyright) znajdują się w zakładce „Ustawienia”.</small>
    </div>
  </div>

  <div class="sticky-bottom bg-white p-3 border-top d-flex justify-content-end">
    <a href="/admin/sections" class="btn btn-link me-2">Anuluj</a>
    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Zapisz wszystkie zmiany</button>
  </div>
</form>

<%- include('partials/_bottom') %>
