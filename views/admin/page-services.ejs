<%- include('partials/_top') %>

<%
  const find = (key) => c[key] || { id: null, key, text: '' };
%>

<div class="page-header d-print-none mb-3">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title"><i class="ti ti-grid-dots me-2"></i> Strona Services (landing page)</h2>
      <p class="text-muted"><a href="/services" target="_blank">Podgląd na żywo</a> · URL: <code>/services</code></p>
    </div>
    <div class="col-auto">
      <a href="/admin/pages" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i> Wróć</a>
    </div>
  </div>
</div>

<form action="/admin/pages/services" method="post">
  <!-- Hero -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-flag me-2"></i> Hero</h3></div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <label class="form-label">Tytuł hero</label>
          <input type="text" class="form-control" name="components[<%= find('services_lp_hero_title').id %>][text]" value="<%= find('services_lp_hero_title').text %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Podtytuł hero</label>
          <input type="text" class="form-control" name="components[<%= find('services_lp_hero_subtitle').id %>][text]" value="<%= find('services_lp_hero_subtitle').text %>">
        </div>
        <div class="col-12 mt-2">
          <label class="form-label">Tekst wprowadzający</label>
          <textarea class="form-control" rows="2" name="components[<%= find('services_lp_intro').id %>][text]"><%= find('services_lp_intro').text %></textarea>
        </div>
        <div class="col-12 mt-2">
          <label class="form-label">Nagłówek sekcji „Proces"</label>
          <input type="text" class="form-control" name="components[<%= find('services_lp_process_title').id %>][text]" value="<%= find('services_lp_process_title').text %>">
        </div>
      </div>
    </div>
  </div>

  <div class="sticky-bottom bg-white p-3 border-top d-flex justify-content-end">
    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Zapisz zmiany</button>
  </div>
</form>

<!-- Services (dynamic tiles) -->
<div class="card mb-3 mt-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title"><i class="ti ti-list me-2"></i> Lista usług (kafelki)</h3>
    <span class="badge bg-muted text-muted"><%= services.length %>/16</span>
  </div>
  <div class="card-body">
    <% if (services.length) { %>
      <% services.forEach(function(s, i) { %>
        <div class="border-bottom pb-3 mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong class="small text-muted">Usługa #<%= i + 1 %> · pozycja <%= s.position %></strong>
            <div class="d-flex gap-1">
              <form action="/admin/components/<%= s.id %>/move" method="post" class="d-inline">
                <input type="hidden" name="direction" value="up">
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="W górę" <%= i === 0 ? 'disabled' : '' %>><i class="ti ti-chevron-up"></i></button>
              </form>
              <form action="/admin/components/<%= s.id %>/move" method="post" class="d-inline">
                <input type="hidden" name="direction" value="down">
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="W dół" <%= i === services.length - 1 ? 'disabled' : '' %>><i class="ti ti-chevron-down"></i></button>
              </form>
              <form action="/admin/components/<%= s.id %>/toggle" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm <%= s.is_visible ? 'btn-outline-success' : 'btn-outline-secondary' %>" title="<%= s.is_visible ? 'Ukryj' : 'Pokaż' %>">
                  <i class="ti ti-<%= s.is_visible ? 'eye' : 'eye-off' %>"></i>
                </button>
              </form>
              <form action="/admin/components/<%= s.id %>/delete" method="post" class="d-inline"
                    onsubmit="return confirm('Usunąć usługę „<%= (s.label || '').replace(/'/g,'') %>"?')">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Usuń"><i class="ti ti-trash"></i></button>
              </form>
            </div>
          </div>
          <form action="/admin/components/<%= s.id %>" method="post" class="row g-2 align-items-end">
            <div class="col-md-2">
              <label class="form-label small">Ikona</label>
              <input type="text" class="form-control form-control-sm" name="icon" value="<%= s.icon %>" placeholder="lni lni-guide">
            </div>
            <div class="col-md-3">
              <label class="form-label small">Tytuł</label>
              <input type="text" class="form-control form-control-sm" name="label" value="<%= s.label %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label small">Opis</label>
              <input type="text" class="form-control form-control-sm" name="text" value="<%= s.text %>">
            </div>
            <div class="col-md-2">
              <label class="form-label small">Zdjęcie (ścieżka)</label>
              <input type="text" class="form-control form-control-sm" name="image_url" value="<%= s.image_url || '' %>">
            </div>
            <div class="col-md-1">
              <button type="submit" class="btn btn-sm btn-outline-primary w-100" title="Zapisz"><i class="ti ti-check"></i></button>
            </div>
          </form>
          <form action="/admin/components/<%= s.id %>/move" method="post" class="row g-2 mt-2 align-items-end">
            <div class="col-md-3">
              <label class="form-label small">Ustaw pozycję ręcznie</label>
              <div class="input-group input-group-sm">
                <input type="number" class="form-control" name="position" value="<%= s.position %>" placeholder="<%= s.position %>">
                <button type="submit" class="btn btn-outline-secondary"><i class="ti ti-check"></i></button>
              </div>
            </div>
          </form>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-center text-muted py-4 mb-3">Brak usług. Dodaj pierwszą poniżej.</p>
    <% } %>

    <hr class="my-3">
    <h6 class="mb-2">Dodaj nową usługę</h6>
    <form action="/admin/components/new" method="post" class="row g-2 align-items-end">
      <input type="hidden" name="block_type" value="service_full">
      <div class="col-md-2">
        <label class="form-label small">Ikona</label>
        <input type="text" class="form-control form-control-sm" name="icon" placeholder="lni lni-guide">
      </div>
      <div class="col-md-3">
        <label class="form-label small">Tytuł</label>
        <input type="text" class="form-control form-control-sm" name="label" required>
      </div>
      <div class="col-md-4">
        <label class="form-label small">Opis</label>
        <input type="text" class="form-control form-control-sm" name="text">
      </div>
      <div class="col-md-2">
        <label class="form-label small">Zdjęcie (ścieżka)</label>
        <input type="text" class="form-control form-control-sm" name="image_url" placeholder="uploads/img-…">
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-sm btn-primary w-100" <%= services.length >= 16 ? 'disabled' : '' %>><i class="ti ti-plus"></i></button>
      </div>
    </form>
  </div>
</div>

<!-- Process steps (dynamic tiles) -->
<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title"><i class="ti ti-list-numbers me-2"></i> Kroki procesu (kafelki)</h3>
    <span class="badge bg-muted text-muted"><%= steps.length %>/16</span>
  </div>
  <div class="card-body">
    <% if (steps.length) { %>
      <% steps.forEach(function(st, i) { %>
        <div class="border-bottom pb-3 mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong class="small text-muted">Krok #<%= i + 1 %> · pozycja <%= st.position %></strong>
            <div class="d-flex gap-1">
              <form action="/admin/components/<%= st.id %>/move" method="post" class="d-inline">
                <input type="hidden" name="direction" value="up">
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="W górę" <%= i === 0 ? 'disabled' : '' %>><i class="ti ti-chevron-up"></i></button>
              </form>
              <form action="/admin/components/<%= st.id %>/move" method="post" class="d-inline">
                <input type="hidden" name="direction" value="down">
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="W dół" <%= i === steps.length - 1 ? 'disabled' : '' %>><i class="ti ti-chevron-down"></i></button>
              </form>
              <form action="/admin/components/<%= st.id %>/delete" method="post" class="d-inline"
                    onsubmit="return confirm('Usunąć krok „<%= (st.label || '').replace(/'/g,'') %>"?')">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Usuń"><i class="ti ti-trash"></i></button>
              </form>
            </div>
          </div>
          <form action="/admin/components/<%= st.id %>" method="post" class="row g-2 align-items-end">
            <div class="col-md-4">
              <label class="form-label small">Tytuł</label>
              <input type="text" class="form-control form-control-sm" name="label" value="<%= st.label %>" required>
            </div>
            <div class="col-md-7">
              <label class="form-label small">Opis</label>
              <input type="text" class="form-control form-control-sm" name="text" value="<%= st.text %>">
            </div>
            <div class="col-md-1">
              <button type="submit" class="btn btn-sm btn-outline-primary w-100" title="Zapisz"><i class="ti ti-check"></i></button>
            </div>
          </form>
          <form action="/admin/components/<%= st.id %>/move" method="post" class="row g-2 mt-2 align-items-end">
            <div class="col-md-3">
              <label class="form-label small">Ustaw pozycję ręcznie</label>
              <div class="input-group input-group-sm">
                <input type="number" class="form-control" name="position" value="<%= st.position %>" placeholder="<%= st.position %>">
                <button type="submit" class="btn btn-outline-secondary"><i class="ti ti-check"></i></button>
              </div>
            </div>
          </form>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-center text-muted py-4 mb-3">Brak kroków. Dodaj pierwszy poniżej.</p>
    <% } %>

    <hr class="my-3">
    <h6 class="mb-2">Dodaj nowy krok</h6>
    <form action="/admin/components/new" method="post" class="row g-2 align-items-end">
      <input type="hidden" name="block_type" value="process_step">
      <div class="col-md-4">
        <label class="form-label small">Tytuł</label>
        <input type="text" class="form-control form-control-sm" name="label" required>
      </div>
      <div class="col-md-7">
        <label class="form-label small">Opis</label>
        <input type="text" class="form-control form-control-sm" name="text">
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-sm btn-primary w-100" <%= steps.length >= 16 ? 'disabled' : '' %>><i class="ti ti-plus"></i></button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/_bottom') %>
