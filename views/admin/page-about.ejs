<%- include('partials/_top') %>

<%
  const find = (key) => c[key] || { id: null, key, text: '', image_url: '' };
%>

<div class="page-header d-print-none mb-3">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title"><i class="ti ti-info-circle me-2"></i> Strona About (landing page)</h2>
      <p class="text-muted"><a href="/about" target="_blank">Podgląd na żywo</a> · URL: <code>/about</code></p>
    </div>
    <div class="col-auto">
      <a href="/admin/pages" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i> Wróć</a>
    </div>
  </div>
</div>

<form action="/admin/pages/about" method="post">

  <!-- Hero -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-flag me-2"></i> Hero (baner górny)</h3></div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <label class="form-label">Tytuł hero</label>
          <input type="text" class="form-control" name="components[<%= find('about_lp_hero_title').id %>][text]" value="<%= find('about_lp_hero_title').text %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Podtytuł hero</label>
          <input type="text" class="form-control" name="components[<%= find('about_lp_hero_subtitle').id %>][text]" value="<%= find('about_lp_hero_subtitle').text %>">
        </div>
      </div>
    </div>
  </div>

  <!-- Intro -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-writing me-2"></i> Sekcja „Kim jesteśmy"</h3></div>
    <div class="card-body">
      <div class="mb-3">
        <label class="form-label">Nagłówek sekcji</label>
        <input type="text" class="form-control" name="components[<%= find('about_lp_intro_title').id %>][text]" value="<%= find('about_lp_intro_title').text %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Tekst (akapity oddzielone pustą linią)</label>
        <textarea class="form-control" rows="6" name="components[<%= find('about_lp_intro_text').id %>][text]"><%= find('about_lp_intro_text').text %></textarea>
      </div>
      <div class="mb-3">
        <label class="form-label">Zdjęcie (ścieżka)</label>
        <input type="text" class="form-control" name="components[<%= find('about_lp_intro_image').id %>][image_url]" value="<%= find('about_lp_intro_image').image_url %>">
        <small class="form-hint text-muted">Np. <code>traveland/assets/images/about_image.jpg</code> lub <code>uploads/img-…</code>.</small>
      </div>
      <p class="text-muted small mb-0">
        <i class="ti ti-info-circle me-1"></i>
        Liczniki (4) są edytowane w zakładce <a href="/admin/sections">„Treść sekcji"</a> — są współdzielone między home page a About LP.
      </p>
    </div>
  </div>

  <!-- Zespół — text block -->
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title"><i class="ti ti-users me-2"></i> Sekcja „Zespół" (tekst)</h3></div>
    <div class="card-body">
      <label class="form-label">Tekst o zespole (np. liczba osób, lokalizacje)</label>
      <textarea class="form-control" rows="3" name="components[<%= find('about_lp_team_text').id %>][text]"><%= find('about_lp_team_text').text %></textarea>
      <small class="form-hint text-muted">Np. „Nasz zespół to 12 osób w 3 krajach — planerzy, przewodnicy i pisarze, którzy łączy miłość do spokojnych podróży."</small>
    </div>
  </div>

  <div class="sticky-bottom bg-white p-3 border-top d-flex justify-content-end">
    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Zapisz zmiany</button>
  </div>
</form>

<!-- Values (dynamic tiles) -->
<div class="card mb-3 mt-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title"><i class="ti ti-heart me-2"></i> Wartości (kafelki)</h3>
    <span class="badge bg-muted text-muted"><%= values.length %>/16</span>
  </div>
  <div class="card-body">
    <% if (values.length) { %>
      <% values.forEach(function(v, i) { %>
        <div class="border-bottom pb-3 mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong class="small text-muted">Kafelek #<%= i + 1 %> · pozycja <%= v.position %></strong>
            <div class="d-flex gap-1">
              <form action="/admin/components/<%= v.id %>/move" method="post" class="d-inline">
                <input type="hidden" name="direction" value="up">
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="W górę" <%= i === 0 ? 'disabled' : '' %>><i class="ti ti-chevron-up"></i></button>
              </form>
              <form action="/admin/components/<%= v.id %>/move" method="post" class="d-inline">
                <input type="hidden" name="direction" value="down">
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="W dół" <%= i === values.length - 1 ? 'disabled' : '' %>><i class="ti ti-chevron-down"></i></button>
              </form>
              <form action="/admin/components/<%= v.id %>/toggle" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm <%= v.is_visible ? 'btn-outline-success' : 'btn-outline-secondary' %>" title="<%= v.is_visible ? 'Ukryj' : 'Pokaż' %>">
                  <i class="ti ti-<%= v.is_visible ? 'eye' : 'eye-off' %>"></i>
                </button>
              </form>
              <form action="/admin/components/<%= v.id %>/delete" method="post" class="d-inline"
                    onsubmit="return confirm('Usunąć kafelek „<%= (v.label || '').replace(/'/g,'') %>"?')">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Usuń"><i class="ti ti-trash"></i></button>
              </form>
            </div>
          </div>
          <form action="/admin/components/<%= v.id %>" method="post" class="row g-2 align-items-end">
            <div class="col-md-2">
              <label class="form-label small">Ikona</label>
              <input type="text" class="form-control form-control-sm" name="icon" value="<%= v.icon %>" placeholder="lni lni-heart">
            </div>
            <div class="col-md-3">
              <label class="form-label small">Tytuł</label>
              <input type="text" class="form-control form-control-sm" name="label" value="<%= v.label %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small">Opis</label>
              <input type="text" class="form-control form-control-sm" name="text" value="<%= v.text %>">
            </div>
            <div class="col-md-1">
              <button type="submit" class="btn btn-sm btn-outline-primary w-100" title="Zapisz"><i class="ti ti-check"></i></button>
            </div>
          </form>
          <form action="/admin/components/<%= v.id %>/move" method="post" class="row g-2 mt-2 align-items-end">
            <div class="col-md-3">
              <label class="form-label small">Ustaw pozycję ręcznie</label>
              <div class="input-group input-group-sm">
                <input type="number" class="form-control" name="position" value="<%= v.position %>" placeholder="<%= v.position %>">
                <button type="submit" class="btn btn-outline-secondary"><i class="ti ti-check"></i></button>
              </div>
            </div>
          </form>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-center text-muted py-4 mb-3">Brak kafelków. Dodaj pierwszy poniżej.</p>
    <% } %>

    <hr class="my-3">
    <h6 class="mb-2">Dodaj nowy kafelek wartości</h6>
    <form action="/admin/components/new" method="post" class="row g-2 align-items-end">
      <input type="hidden" name="block_type" value="value">
      <div class="col-md-2">
        <label class="form-label small">Ikona</label>
        <input type="text" class="form-control form-control-sm" name="icon" placeholder="lni lni-heart">
      </div>
      <div class="col-md-3">
        <label class="form-label small">Tytuł</label>
        <input type="text" class="form-control form-control-sm" name="label" required>
      </div>
      <div class="col-md-6">
        <label class="form-label small">Opis</label>
        <input type="text" class="form-control form-control-sm" name="text">
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-sm btn-primary w-100" <%= values.length >= 16 ? 'disabled' : '' %>><i class="ti ti-plus"></i></button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/_bottom') %>
