<%- include('partials/_top') %>

<div class="page-header d-print-none mb-3">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title"><i class="ti ti-file-text me-2"></i><%= page ? 'Edycja strony' : 'Nowa strona statyczna' %></h2>
    </div>
    <div class="col-auto">
      <a href="/admin/static-pages" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i> Wróć</a>
    </div>
  </div>
</div>

<form action="<%= page ? '/admin/static-pages/' + page.id + '/edit' : '/admin/static-pages/new' %>" method="post">
  <div class="row">
    <div class="col-lg-8">
      <div class="card mb-3">
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label">Tytuł <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control" value="<%= page ? page.title : '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Slug (URL) <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text">/p/</span>
              <input type="text" name="slug" class="form-control" value="<%= page ? page.slug : '' %>" required
                     pattern="[a-z0-9-]+" title="Tylko małe litery, cyfry i myślniki">
            </div>
            <small class="form-hint text-muted">Tylko małe litery, cyfry i myślniki. Np. <code>privacy-policy</code>.</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Treść <span class="text-danger">*</span></label>
            <textarea name="body" class="form-control" rows="14" required><%= page ? page.body : '' %></textarea>
            <small class="form-hint text-muted">Akapity oddziel pustą linią.</small>
          </div>
        </div>
      </div>
      <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> <%= page ? 'Zapisz zmiany' : 'Utwórz stronę' %></button>
    </div>
    <div class="col-lg-4">
      <div class="card">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-info-circle me-2"></i> Informacje</h3></div>
        <div class="card-body small text-muted">
          <p class="mb-1"><strong>URL:</strong> <code>/p/&lt;slug&gt;</code></p>
          <p class="mb-1"><strong>Widoczność:</strong> Domyślnie widoczna. Można ukryć w liście.</p>
          <p class="mb-1"><strong>Linkowanie:</strong> Strony statyczne nie są w menu głównym. Linkuj je ręcznie, np. w stopce edytując ustawienia serwisu.</p>
        </div>
      </div>
    </div>
  </div>
</form>

<%- include('partials/_bottom') %>
