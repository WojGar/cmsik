<%- include('partials/_top') %>

<div class="page-header d-print-none mb-3">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title">Pulpit</h2>
      <p class="text-muted">Witaj, <%= (currentUser && currentUser.name) || (currentUser && currentUser.email) || 'Admin' %>! Oto podsumowanie Twojego serwisu.</p>
    </div>
    <div class="col-auto">
      <a href="/" target="_blank" class="btn btn-outline-primary"><i class="ti ti-external-link me-1"></i> Otwórz stronę</a>
      <a href="/admin/posts/new" class="btn btn-primary"><i class="ti ti-plus me-1"></i> Nowy wpis</a>
    </div>
  </div>
</div>

<!-- Stat cards -->
<div class="row row-deck row-cards mb-4">
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card">
      <div class="card-body d-flex align-items-center">
        <div class="me-3"><i class="ti ti-article stat-icon text-primary"></i></div>
        <div class="flex-fill">
          <div class="stat-value"><%= stats.posts %></div>
          <div class="stat-label">Wpisy</div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card">
      <div class="card-body d-flex align-items-center">
        <div class="me-3"><i class="ti ti-edit stat-icon" style="color:#f59f00"></i></div>
        <div class="flex-fill">
          <div class="stat-value"><%= stats.drafts %></div>
          <div class="stat-label">Szkice</div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card">
      <div class="card-body d-flex align-items-center">
        <div class="me-3"><i class="ti ti-mail stat-icon text-success"></i></div>
        <div class="flex-fill">
          <div class="stat-value"><%= stats.messages %></div>
          <div class="stat-label">Nowe wiadomości</div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card">
      <div class="card-body d-flex align-items-center">
        <div class="me-3"><i class="ti ti-mailbox stat-icon text-info"></i></div>
        <div class="flex-fill">
          <div class="stat-value"><%= stats.subscribers %></div>
          <div class="stat-label">Subskrybenci</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent posts + messages -->
<div class="row row-deck row-cards">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="ti ti-history me-2"></i> Ostatnio edytowane wpisy</h3>
        <a href="/admin/posts" class="btn btn-sm btn-outline-primary">Wszystkie</a>
      </div>
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead>
            <tr><th>Tytuł</th><th>Autor</th><th>Status</th><th>Aktualizacja</th></tr>
          </thead>
          <tbody>
            <% recentPosts.forEach(function(p) { %>
              <tr>
                <td><a href="/admin/posts/<%= p.id %>/edit"><%= p.title %></a></td>
                <td class="text-muted"><%= p.author %></td>
                <td><span class="badge status-<%= p.status %>"><%= p.status === 'published' ? 'Opublikowany' : 'Szkic' %></span></td>
                <td class="text-muted"><%= formatDate(p.updated_at) %></td>
              </tr>
            <% }); %>
            <% if (!recentPosts.length) { %>
              <tr><td colspan="4" class="text-center text-muted py-4">Brak wpisów. <a href="/admin/posts/new">Dodaj pierwszy</a>.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="ti ti-mail me-2"></i> Ostatnie wiadomości</h3>
        <a href="/admin/messages" class="btn btn-sm btn-outline-primary">Wszystkie</a>
      </div>
      <ul class="list-group list-group-flush">
        <% recentMsgs.forEach(function(m) { %>
          <li class="list-group-item">
            <div class="d-flex w-100 justify-content-between">
              <strong><%= m.name %></strong>
              <small class="text-muted"><%= formatDate(m.created_at) %></small>
            </div>
            <div class="text-muted small"><%= m.email %></div>
            <div class="text-truncate small"><%= m.body %></div>
          </li>
        <% }); %>
        <% if (!recentMsgs.length) { %>
          <li class="list-group-item text-center text-muted py-4">Brak wiadomości.</li>
        <% } %>
      </ul>
    </div>
  </div>
</div>

<%- include('partials/_bottom') %>
