<%- include('partials/_top') %>

<div class="page-header d-print-none mb-3">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title"><i class="ti ti-user me-2"></i> Konto administratora</h2>
      <p class="text-muted">Zmień hasło do panelu.</p>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-key me-2"></i> Dane konta</h3></div>
      <div class="card-body">
        <p class="mb-1"><strong>E-mail:</strong> <%= currentUser.email %></p>
        <p class="mb-1"><strong>Imię i nazwisko:</strong> <%= currentUser.name || '—' %></p>
        <p class="mb-0 text-muted small"> Konto utworzone w systemie CMSik. Aby zmienić e-mail, edytuj rekord w bazie.</p>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-lock me-2"></i> Zmiana hasła</h3></div>
      <div class="card-body">
        <form action="/admin/account/password" method="post">
          <div class="mb-3">
            <label class="form-label">Aktualne hasło</label>
            <input type="password" name="current" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Nowe hasło</label>
            <input type="password" name="password" class="form-control" minlength="6" required>
            <small class="form-hint text-muted">Minimum 6 znaków.</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Powtórz nowe hasło</label>
            <input type="password" name="password_confirm" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Zmień hasło</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/_bottom') %>
