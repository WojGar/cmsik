<%- include('partials/_top') %>

<div class="page-header d-print-none mb-3">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title"><i class="ti ti-file-text me-2"></i> Strony statyczne</h2>
      <p class="text-muted">Proste strony informacyjne (Privacy Policy, Terms itp.). Linkowane ręcznie, np. w stopce.</p>
    </div>
    <div class="col-auto">
      <a href="/admin/static-pages/new" class="btn btn-primary"><i class="ti ti-plus me-1"></i> Nowa strona</a>
    </div>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-vcenter card-table">
      <thead>
        <tr>
          <th>Tytuł</th>
          <th>Slug (URL)</th>
          <th>Widoczna</th>
          <th>Aktualizacja</th>
          <th class="text-end">Akcje</th>
        </tr>
      </thead>
      <tbody>
        <% pages.forEach(function(p) { %>
          <tr>
            <td><a href="/admin/static-pages/<%= p.id %>/edit"><%= p.title %></a></td>
            <td><code>/p/<%= p.slug %></code></td>
            <td>
              <% if (p.is_visible) { %>
                <span class="badge bg-success">tak</span>
              <% } else { %>
                <span class="badge bg-warning">ukryta</span>
              <% } %>
            </td>
            <td class="text-muted"><%= formatDate(p.updated_at) %></td>
            <td class="text-end">
              <a href="/p/<%= p.slug %>" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="ti ti-external-link"></i></a>
              <a href="/admin/static-pages/<%= p.id %>/edit" class="btn btn-sm btn-outline-primary"><i class="ti ti-edit"></i></a>
              <form action="/admin/static-pages/<%= p.id %>/toggle" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm <%= p.is_visible ? 'btn-outline-success' : 'btn-outline-secondary' %>">
                  <i class="ti ti-<%= p.is_visible ? 'eye' : 'eye-off' %>"></i>
                </button>
              </form>
              <form action="/admin/static-pages/<%= p.id %>/delete" method="post" class="d-inline"
                    onsubmit="return confirm('Usunąć stronę „<%= p.title.replace(/'/g,'') %>"?')">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }); %>
        <% if (!pages.length) { %>
          <tr><td colspan="5" class="text-center text-muted py-5">Brak stron. <a href="/admin/static-pages/new">Dodaj pierwszą</a>.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/_bottom') %>
